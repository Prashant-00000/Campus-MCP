# ==============================================================================
# MCP Agent & Benchmark — Environment Configuration
# Copy to .env and fill in your values. .env is in .gitignore (never commit it).
# ==============================================================================

# ------------------------------------------------------------------------------
# Model A — Small / Fast (Groq: openai/gpt-oss-20b)
# ------------------------------------------------------------------------------
MODEL_A_PROVIDER=groq
MODEL_A_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=gsk_your_key_here

# ------------------------------------------------------------------------------
# Model B — Large / High-Reasoning (Groq: openai/gpt-oss-120b)
# ------------------------------------------------------------------------------
MODEL_B_PROVIDER=groq
MODEL_B_MODEL=openai/gpt-oss-120b
# Uses the same GROQ_API_KEY above.

# ------------------------------------------------------------------------------
# Alternative: OpenRouter (free-tier models, no credit card required)
# https://openrouter.ai/models?filter=free
# ------------------------------------------------------------------------------
# MODEL_A_PROVIDER=openrouter
# MODEL_A_MODEL=google/gemma-2-9b-it:free
# MODEL_B_PROVIDER=openrouter
# MODEL_B_MODEL=meta-llama/llama-3.1-70b-instruct:free
# OPENROUTER_API_KEY=sk-or-your_key_here

# ------------------------------------------------------------------------------
# Alternative: Local Ollama (no API key, free)
# Run: ollama pull llama3.2 && ollama serve
# ------------------------------------------------------------------------------
# MODEL_A_PROVIDER=ollama
# MODEL_A_MODEL=llama3.2

# ------------------------------------------------------------------------------
# Alternative: Gemini (OpenAI-compatible endpoint)
# https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
# MODEL_A_PROVIDER=gemini
# MODEL_A_MODEL=gemini-1.5-flash-latest
# GEMINI_API_KEY=your_gemini_key

# ------------------------------------------------------------------------------
# Shared eval / red-team defaults (if you only want one model)
# These are also read by provider_from_env() as a fallback.
# ------------------------------------------------------------------------------
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
