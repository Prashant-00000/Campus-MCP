# ==============================================================================
# MCP Agent & Benchmark Environment Configuration
# ==============================================================================
# Select mode: 'simulator' (zero-cost offline reproduction) or 'live'
MCP_AGENT_MODE=simulator

# Model Configurations for Live Provider (ignored in simulator mode)
# Supported providers: openai, groq, openrouter, ollama
MODEL_A_PROVIDER=openai
MODEL_A_NAME=gpt-4o-mini
MODEL_A_API_KEY=your_openai_api_key_here

MODEL_B_PROVIDER=openai
MODEL_B_NAME=gpt-4o
MODEL_B_API_KEY=your_openai_api_key_here

# Groq alternative example:
# GROQ_API_KEY=gsk_...
# MODEL_B_PROVIDER=groq
# MODEL_B_NAME=llama-3.3-70b-versatile

# Agent Execution Parameters
AGENT_MAX_STEPS=10
AGENT_TIMEOUT_SECONDS=30
AGENT_TEMPERATURE=0.0
AGENT_CACHE_ENABLED=true
